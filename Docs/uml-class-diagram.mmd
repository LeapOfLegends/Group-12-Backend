classDiagram
    class Admin {
        -Long adminId
        -String firstName
        -String lastName
        -String email
        -String passwordHash
        -DateTime createdAt
        +viewClients()
        +viewOrders()
        +viewTradeHistory()
    }

    class Client {
        -Long clientId
        -String firstName
        -String lastName
        -String email
        -String passwordHash
        -Decimal accountBalance
        -DateTime createdAt
        +viewOrders()
        +viewHoldings()
        +viewBalance()
        +hasSufficientBalance(Decimal amount) Boolean
        +increaseBalance(Decimal amount) void
        +decreaseBalance(Decimal amount) void
    }

    class Order {
        -Long orderId
        -OrderType orderType
        -Decimal quantity
        -OrderStatus status
        -Decimal executionPrice
        -Decimal totalValue
        -DateTime submittedAt
        -DateTime? acceptedAt
        -DateTime? completedAt
        -String? rejectionReason
        +accept() void
        +fill(Decimal executionPrice) void
        +reject(String reason) void
        +calculateTotalValue() Decimal
    }

    class Instrument {
        -Long instrumentId
        -String symbol
        -String instrumentName
        -AssetClass assetClass
        -String market
        -String currency
        -Decimal price
        -Boolean isTradable
        +updatePrice(Decimal newPrice) void
        +markTradable() void
        +markUntradable() void
    }

    class Holding {
        -Long holdingId
        -Decimal quantity
        -Decimal averageCost
        -DateTime updatedAt
        +hasSufficientQuantity(Decimal quantity) Boolean
        +increaseQuantity(Decimal quantity, Decimal purchasePrice) void
        +decreaseQuantity(Decimal quantity) void
        +updateAverageCost(Decimal price) void
    }

    class Session {
        -Long sessionId
        -DateTime createdAt
        -DateTime expiresAt
        -DateTime revokedAt
        +isExpired() Boolean
        +isRevoked() Boolean
        +isValid() Boolean
        +revoke() void
    }

    class OrderType {
        <<enumeration>>
        BUY
        SELL
    }

    class OrderStatus {
        <<enumeration>>
        SUBMITTED
        ACCEPTED
        FILLED
        REJECTED
    }

    class AssetClass {
        <<enumeration>>
        EQUITY
        CRYPTO
    }

    Client "1" -- "0..*" Order : places
    Client "1" -- "0..*" Holding : owns
    Client "1" -- "0..*" Session : has
    Instrument "1" -- "0..*" Order : referenced by
    Instrument "1" -- "0..*" Holding : held as
